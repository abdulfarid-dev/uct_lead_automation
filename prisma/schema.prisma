generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id                    Int      @id @default(autoincrement())
  sector                String
  website               String   @unique
  location              String?
  phone                 String?  @unique
  email                 String?  @unique
  googleBusinessProfile String?

  // ─────────────────────────────────────
  // LEAD VERIFICATION
  // ─────────────────────────────────────
  verificationStatus String   @default("under_review")
  isVerified         Boolean  @default(false)
  verifiedAt         DateTime?

  // ─────────────────────────────────────
  // EMAIL LIFECYCLE
  // pending → scheduled → sent → delivered → replied
  // failed = sending/delivery failure
  // ─────────────────────────────────────
  emailStatus      String    @default("pending")
  emailScheduledAt DateTime?
  emailSentAt      DateTime?
  emailDeliveredAt DateTime?
  emailOpenedAt    DateTime?
  emailClickedAt   DateTime?
  emailRepliedAt   DateTime?
  emailError       String?

  // Brevo transactional message ID
  emailMessageId String?

  // ─────────────────────────────────────
  // EMAIL SNAPSHOT / AUDIT
  // Stores exactly what was used when email
  // was scheduled/sent.
  // ─────────────────────────────────────
  emailTemplateName  String?
  emailSubject       String?
  emailBody          String?
  emailSenderName    String?
  emailSenderAddress String?

  // ─────────────────────────────────────
  // TIMESTAMPS
  // ─────────────────────────────────────
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─────────────────────────────────────
  // INDEXES
  // ─────────────────────────────────────
  @@index([emailStatus])
  @@index([emailScheduledAt])
  @@index([verificationStatus])
  @@index([emailMessageId])
}